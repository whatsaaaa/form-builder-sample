{
  "name": "react-checkout",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --names api,web \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts dist",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@formisch/react": "^1.2.0",
    "@hono/node-server": "^2.1.7",
    "@valibot/i18n": "^1.3.0",
    "@whatsaaaa/form-builder-affects": "0.2.2-rc.0",
    "@whatsaaaa/form-builder-react": "1.0.0-rc.0",
    "@whatsaaaa/form-builder-schema": "1.0.0-rc.0",
    "hono": "^4.13.18",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@11.27.0",
  "engines": {
    "node": ">=20.19"
  }
}
